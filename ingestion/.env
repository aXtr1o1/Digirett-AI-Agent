# Lovdata API
LOVDATA_API_URL=https://api.lovdata.no
LOVDATA_API_KEY=your-lovdata-api-key

# Milvus Configuration
MILVUS_HOST=
MILVUS_PORT=
MILVUS_COLLECTION=
MILVUS_INDEX_TYPE=
MILVUS_METRIC_TYPE=
MILVUS_NLIST=

# Processing Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_WORKERS=4

# Checkpoint & Logging
CHECKPOINT_DIR=./data/checkpoints
LOG_DIR=./data/logs
LOG_LEVEL=INFO

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
SENTRY_DSN=  # Optional