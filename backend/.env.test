# ============================================
# .env.test
# Testing environment configuration
# ============================================

# ========================
# API Settings
# ========================
DEBUG=True
ALLOWED_ORIGINS=["*"]

# ========================
# Milvus (Mock / Local)
# ========================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=test_collection
MILVUS_METRIC_TYPE=COSINE
MILVUS_INDEX_TYPE=HNSW

# ========================
# Azure OpenAI (Mock)
# ========================
AZURE_OPENAI_ENDPOINT=http://mock-openai
AZURE_OPENAI_API_KEY=test-key
AZURE_OPENAI_DEPLOYMENT=test-model
AZURE_OPENAI_API_VERSION=2025-01-01-preview
OPENAI_TEMPERATURE=0.0

AZURE_OPENAI_EMBEDDING_DEPLOYMENT=test-embedding
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-02-01

# ========================
# RAG Settings
# ========================
DEFAULT_TOP_K=3
MAX_TOP_K=5
MIN_SIMILARITY_SCORE=0.0
CONTEXT_MAX_LENGTH=8000

# ========================
# Rate Limiting
# ========================
RATE_LIMIT_PER_MINUTE=10000

# ========================
# Logging
# ========================
LOG_LEVEL=DEBUG
LOG_DIR=./logs

# ========================
# Monitoring
# ========================
ENABLE_METRICS=false
METRICS_PORT=9091

# ========================
# Retry Logic
# ========================
MAX_RETRIES=1
RETRY_DELAY=0.1

# ========================
# Redis (Optional or Disabled)
# ========================
REDIS_HOST=localhost
REDIS_DB=0
REDIS_PORT=6379
REDIS_PASSWORD=
ENABLE_CACHE=false

CONVERSATION_CONTEXT_TTL=60
USER_SESSION_TTL=60
STREAMING_BUFFER_TTL=10
MAX_CONTEXT_MESSAGES=5

# ========================
# Supabase (Mock)
# ========================
SUPABASE_URL=http://mock-supabase
SUPABASE_KEY=test-key
SUPABASE_SERVICE_ROLE_KEY=test-service-key

# ========================
# Conversation Settings
# ========================
AUTO_SUMMARY_THRESHOLD=5
MAX_CONVERSATION_TITLE_LENGTH=50
SOFT_DELETE=true
